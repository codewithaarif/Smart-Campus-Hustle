# Runtime
NODE_ENV=development
PORT=5050
DATABASE_PATH=
SEED_DEMO_DATA=false
SIMULATE_GPS=false

# Required production secrets (generate independent random values of at least 32 bytes)
JWT_SECRET=
QR_SECRET=
EMERGENCY_OVERRIDE_PIN=

# Payments: mock is development-only; production requires Razorpay credentials
PAYMENTS_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set exact comma-separated frontend origins when frontend and API use different origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
ENABLE_DEMO_ENDPOINTS=false
